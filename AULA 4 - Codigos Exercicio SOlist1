#include <sys/types.h>
#include <unistd.h>
#include <stdio.h>

int main()
{
    pid_t f1, f4;

    printf("Processo Pai PID = %d\n", getpid());
    f1 = fork();

    if (f1 == 0) {
    
        printf("Filho 1 PID = %d\n", getpid());

        pid_t f2 = fork();
        if (f2 == 0) {
       
            printf("Filho 2 PID = %d\n", getpid());

            pid_t f3 = fork();
            if (f3 == 0) {
                printf("Filho 3 PID = %d\n", getpid());
            }
        }
    } else {
        f4 = fork();

        if (f4 == 0) {
            printf("Filho 4 PID = %d\n", getpid());

            pid_t f5 = fork();
            if (f5 == 0) {
                printf("Filho 5 PID = %d\n", getpid());
            }
        }
    }

    return 0;
}
